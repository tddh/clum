# clum bridge configuration
# Place at /etc/clum/bridge.env (loaded by systemd EnvironmentFile)

# ─── Authentication ───
BRIDGE_AUTH_TOKEN=<your-bridge-token>

# ─── Rmux socket ───
RMUX_SOCKET=/root/.rmux/rmux-0/default

# ─── Hub server connection (outbound, for enrolled bridges) ───
CLUM_SERVER_ADDR=10.220.71.1:9788
CLUM_CA_CERT=/etc/clum/ca.crt

# ─── QUIC listener (inbound, for direct-mode bridges) ───
# QUIC_LISTEN_ADDR=0.0.0.0:9778
# BRIDGE_TLS_CERT=/etc/clum/bridge.crt
# BRIDGE_TLS_KEY=/etc/clum/bridge.key

# ─── Recording ───
RECORDING_ENABLED=true
RECORDING_DIR=/opt/clum/recordings
BRIDGE_AUDIT_DB=/opt/clum/bridge_events.db

# ─── Tuning (optional) ───
# MAX_CONNECTIONS=256
# IDLE_TIMEOUT_SECS=28800
# RECORDING_RETENTION_DAYS=90
# RECORDING_MAX_SIZE_MB=500
# RECORDING_FSYNC_INTERVAL_SECS=5
# RUST_LOG=info
