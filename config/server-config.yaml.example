# clum MCP Server configuration
# Usage: clum-mcp --mode http --config /etc/clum/server-config.yaml
#
# All values can be overridden by CLI args (e.g. --listen, --ca-cert).

# ─── Network ───
listen: "0.0.0.0:9788"
# The server's externally reachable address. Required — `clum-mcp bridge add`
# uses it when generating the one-line bridge install command.
server_addr: "<server-ip>:9788"

# ─── TLS ───
server_cert: "/etc/clum/server.crt"
server_key: "/etc/clum/server.key"
ca_cert: "/etc/clum/ca.crt"

# ─── Host registry ───
hosts_file: "/etc/clum/hosts.yaml"

# ─── Storage ───
audit_db: "/root/.clum/audit.db"
recordings_dir: "/root/.clum/recordings"
static_dir: "/root/.clum"

# ─── Audit settings ───
audit_retention_days: 90
audit_max_size_mb: 500
audit_cleanup_interval_secs: 600
audit_sync_interval_secs: 300

# ─── Recording settings ───
recordings_retention_days: 90
recordings_max_size_mb: 5000
# Keyring directory for PTY recording encryption (X25519 envelope + AES-256-GCM).
# Created automatically with owner-only permissions if missing.
# recording_keys_dir: "/root/.clum/recording-keys"

# ─── Token settings ───
token_ttl_hours: 24

# ─── File transfer bandwidth limits ───
# Default per-stream limit is 0 (unlimited). CUBIC congestion control backs off
# on loss automatically, so no default cap is needed. Set >0 to cap explicitly.
# file_transfer:
#   upload_bandwidth_mbps: 0              # per-stream upload Mbps (0=unlimited)
#   download_bandwidth_mbps: 0            # per-stream download Mbps (0=unlimited)
#   global_upload_bandwidth_mbps: 0       # total upload across all streams (0=unlimited)
#   global_download_bandwidth_mbps: 0     # total download across all streams (0=unlimited)
#   max_upload_concurrency: 16            # concurrent uploads per host

# ─── Inline bridge enrollment (optional) ───
# Bridges can also be enrolled dynamically via the bridge_store SQLite DB.
# bridges:
#   - hostname: tf01
#     token: "8f3a..."
